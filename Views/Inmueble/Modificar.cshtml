@model Inmobiliaria.Models.Inmueble
@{
  ViewData["Title"] = "Modificar Inmueble";
  ViewData["SubTitle"] = "Inmuebles";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<div class="px-3 py-1 row justify-content-center ">
  <div class="col-md-8 p-3">

    <form asp-action="Modificar" method="post" enctype="multipart/form-data"
      class="row shadow-lg rounded border bg-light p-4  justify-content-evenly" autocomplete="off">

      <div class="col-md-12 d-flex justify-content-center align-items-center">
        <h2 class="text-center">Modificar Inmueble</h2>
      </div>

      <input type="hidden" asp-for="IdInmueble" />

      <div class="row">
        <!-- Select2 Propietario -->
        <div class="col-md-12 pb-2">
          <label for="select-propietario" class="form-label">Propietario</label>
          <select asp-for="IdPropietario" id="select-propietario" class="form-select"></select>
          <span asp-validation-for="IdPropietario" class="text-danger"></span>
        </div>

        <!-- Tipo de inmueble -->
        <div class="col-md-6 pb-2">
          <label asp-for="IdTipoInmueble" class="form-label">Tipo de Inmueble</label>
          <select asp-for="IdTipoInmueble" class="form-select"
            asp-items="@(ViewBag.Tipos != null ? new SelectList(ViewBag.Tipos, "IdTipoInmueble", "Nombre") : new SelectList(new List<string>()))">
            <option value="">Seleccione un tipo...</option>
          </select>
          <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
        </div>

        <!-- Uso -->
        <div class="col-md-6 pb-2">
          <label asp-for="Uso" class="form-label"></label>
          <select asp-for="Uso" class="form-select">
            <option value="">Seleccione un uso...</option>
            <option value="1">Residencial</option>
            <option value="2">Comercial</option>
          </select>
          <span asp-validation-for="Uso" class="text-danger"></span>
        </div>

        <!-- Cantidad de ambientes -->
        <div class="col-md-6 pb-2">
          <label asp-for="CantidadAmbientes" class="form-label"></label>
          <select asp-for="CantidadAmbientes" class="form-select"
            asp-items="@(new SelectList(Enumerable.Range(1, 20)))">
            <option value="">Seleccione una cantidad...</option>
          </select>
          <span asp-validation-for="CantidadAmbientes" class="text-danger"></span>
        </div>

        <!-- Precio -->
        <div class="col-md-6 pb-2">
          <label asp-for="Precio" class="form-label"></label>
          <input asp-for="Precio" type="number" class="form-control" />
          <span asp-validation-for="Precio" class="text-danger"></span>
        </div>

        <!-- Direccion con autocomplete -->
        <div class="col-md-12 pb-2 position-relative">
          <label asp-for="Direccion" class="form-label"></label>
          <input asp-for="Direccion" id="direccion" class="form-control" autocomplete="off" />
          <ul id="addrList" class="list-group autocomplete-list"></ul>
          <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>

        <!-- Mapa -->
        <div class="col-12 pb-2">
          <label class="form-label">Ubicacion (mapa)</label>
          <div id="mapa" style="height:320px;border:1px solid #ddd;border-radius:4px"></div>
        </div>

        <!-- Longitud y Latitud -->
        <div class="col-md-6 pb-2">
          <label asp-for="Longitud" class="form-label"></label>
          <input asp-for="Longitud" id="longitud" class="form-control" readonly />
          <span asp-validation-for="Longitud" class="text-danger"></span>
        </div>
        <div class="col-md-6 pb-2">
          <label asp-for="Latitud" class="form-label"></label>
          <input asp-for="Latitud" id="latitud" class="form-control" readonly />
          <span asp-validation-for="Latitud" class="text-danger"></span>
        </div>

        <!-- Descripcion -->
        <div class="col-md-12 pb-2">
          <label asp-for="Descripcion" class="form-label"></label>
          <input asp-for="Descripcion" class="form-control" />
          <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <!-- Estado -->

        <div class="col-md-12 pb-2">
          <label asp-for="Estado" class="form-label"></label>
          <select asp-for="Estado" class="form-select">
            <option value="">Seleccione un estado</option>
            <option value="1">Disponible</option>
            <option value="2">Suspendido</option>
          </select>
          <span asp-validation-for="Estado" class="text-danger"></span>
        </div>

      </div>
      @* --- IMAGENES --- *@
      <div class="row mt-4">
        <div class="col-md-12 pb-3">
          <label class="form-label fw-bold">Portada</label>

          <div id="portada-unificada-container" class="mt-2"></div>
          <p id="portada-placeholder-mensaje" class="text-muted" style="display: none;">No hay imagen de portada.</p>


          <input type="file" asp-for="FilePortada" class="form-control mt-3" accept="image/*"
            id="input-portada-modificar" />

          @{
            var portadaActual = Model.listImagenes?
            .Where(i => i.Tipo == 1)
            .Select(i => new { i.IdImagen, i.Url })
            .FirstOrDefault();
          }
          <script>
            var imagenPortadaExistente = @Html.Raw(portadaActual != null ? Json.Serialize(portadaActual) : "null");
          </script>
        </div>

        <div class="col-md-12 pt-3">
          <label class="form-label fw-bold">Galeria</label>

          <div id="galeria-unificada-carousel" class="carousel slide mb-3" data-bs-ride="carousel"
            style="display: none;">
            <div class="carousel-inner" id="galeria-unificada-inner">
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#galeria-unificada-carousel"
              data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#galeria-unificada-carousel"
              data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
          </div>


          <input type="file" asp-for="FileGaleria" class="form-control" multiple accept="image/*"
            id="input-galeria-modificar" />

          @{
            var galeriaActual = (Model.listImagenes ?? new List<Imagen>())
            .Where(i => i.Tipo == 2)
            .Select(i => new { i.IdImagen, i.Url })
            .ToList();
          }
          <script>
            // img que vienen del servidor
            var imagenesExistentes = @Html.Raw(Json.Serialize(galeriaActual));
          </script>
        </div>

        <div id="container-eliminar-ids"></div>
      </div>
      @* --- FIN IMÁGENES --- *@

      <div class="d-flex justify-content-between mt-3">

        <a asp-action="Index" class="btn btn-secondary">Volver</a>
        <button type="submit" class="btn btn-success">Guardar Cambios</button>
      </div>
    </form>
  </div>
</div>


@section Scripts {
  @await Html.PartialAsync("_ValidationScriptsPartial")

  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script src="~/js/inmueble-form.js"></script>
  <script src="~/js/manejo-imagenes-modificar.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Inicializamos el mapa y Select2
      inicializarFormularioInmueble({
        idPropietario: @Model.IdPropietario,
        propietarioNombre: '@(Model.Propietario?.Nombre + " " + Model.Propietario?.Apellido + " (" + Model.Propietario?.Dni + ")")'
      });
      //Imagenes
      inicializarPortadaUnificada({
        idInputPortada: 'input-portada-modificar',
        idPreviewContainer: 'portada-unificada-container',
        idPlaceholder: 'portada-placeholder-mensaje'
      });


      inicializarGaleriaUnificada({
        idInputGaleria: 'input-galeria-modificar',
        idCarousel: 'galeria-unificada-carousel',
        idCarouselInner: 'galeria-unificada-inner'
      });
    });
  </script>
}