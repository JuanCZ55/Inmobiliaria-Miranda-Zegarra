@model Inmobiliaria.Models.Inmueble
@{
  ViewData["Title"] = "Modificar Inmueble";
  ViewData["SubTitle"] = "Inmuebles";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<div class="px-3 py-1 row justify-content-center h-100">
  <div class="col-md-8 p-3">

    <form asp-action="Modificar" method="post" enctype="multipart/form-data"
      class="row shadow-lg rounded border bg-light p-4 h-100 justify-content-evenly">

      <div class="col-md-12 d-flex justify-content-center align-items-center">
        <h2 class="text-center">Modificar Inmueble</h2>
      </div>

      <input type="hidden" asp-for="IdInmueble" />

      <div class="row">
        <!-- Select2 Propietario -->
        <div class="col-md-12 pb-2">
          <label for="select-propietario" class="form-label">Propietario</label>
          <select asp-for="IdPropietario" id="select-propietario" class="form-select"></select>
          <span asp-validation-for="IdPropietario" class="text-danger"></span>
        </div>

        <!-- Tipo de inmueble -->
        <div class="col-md-6 pb-2">
          <label asp-for="IdTipoInmueble" class="form-label">Tipo de Inmueble</label>
          <select asp-for="IdTipoInmueble" class="form-select"
            asp-items="@(ViewBag.Tipos != null ? new SelectList(ViewBag.Tipos, "IdTipoInmueble", "Nombre") : new SelectList(new List<string>()))">
            <option value="">Seleccione un tipo...</option>
          </select>
          <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
        </div>

        <!-- Uso -->
        <div class="col-md-6 pb-2">
          <label asp-for="Uso" class="form-label"></label>
          <select asp-for="Uso" class="form-select">
            <option value="">Seleccione un uso...</option>
            <option value="1">Residencial</option>
            <option value="2">Comercial</option>
          </select>
          <span asp-validation-for="Uso" class="text-danger"></span>
        </div>

        <!-- Cantidad de ambientes -->
        <div class="col-md-6 pb-2">
          <label asp-for="CantidadAmbientes" class="form-label"></label>
          <select asp-for="CantidadAmbientes" class="form-select"
            asp-items="@(new SelectList(Enumerable.Range(1, 20)))">
            <option value="">Seleccione una cantidad...</option>
          </select>
          <span asp-validation-for="CantidadAmbientes" class="text-danger"></span>
        </div>

        <!-- Precio -->
        <div class="col-md-6 pb-2">
          <label asp-for="Precio" class="form-label"></label>
          <input asp-for="Precio" type="number" class="form-control" />
          <span asp-validation-for="Precio" class="text-danger"></span>
        </div>

        <!-- Direccion con autocomplete -->
        <div class="col-md-12 pb-2 position-relative">
          <label asp-for="Direccion" class="form-label"></label>
          <input asp-for="Direccion" id="direccion" class="form-control" autocomplete="off" />
          <ul id="addrList" class="list-group autocomplete-list"></ul>
          <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>

        <!-- Mapa -->
        <div class="col-12 pb-2">
          <label class="form-label">Ubicacion (mapa)</label>
          <div id="mapa" style="height:320px;border:1px solid #ddd;border-radius:4px"></div>
        </div>

        <!-- Longitud y Latitud -->
        <div class="col-md-6 pb-2">
          <label asp-for="Longitud" class="form-label"></label>
          <input asp-for="Longitud" id="longitud" class="form-control" readonly />
          <span asp-validation-for="Longitud" class="text-danger"></span>
        </div>
        <div class="col-md-6 pb-2">
          <label asp-for="Latitud" class="form-label"></label>
          <input asp-for="Latitud" id="latitud" class="form-control" readonly />
          <span asp-validation-for="Latitud" class="text-danger"></span>
        </div>

        <!-- Descripcion -->
        <div class="col-md-12 pb-2">
          <label asp-for="Descripcion" class="form-label"></label>
          <input asp-for="Descripcion" class="form-control" />
          <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <!-- Estado -->
        @if (Model.Estado == 2)
        {
          <div class="alert alert-warning col-md-12" role="alert">
            El inmueble está actualmente ocupado. No se puede cambiar su estado.
          </div>
        }
        else
        {
          <div class="col-md-12 pb-2">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" class="form-select">
              <option value="">Seleccione un estado</option>
              <option value="1">Disponible</option>
              <option value="3">Suspendido</option>
            </select>
            <span asp-validation-for="Estado" class="text-danger"></span>
          </div>
        }
      </div>
 @* --- IMAGENES (NUEVA LÓGICA PARA MODIFICAR) --- *@
            <div class="row mt-4">
                <h4 class="text-center mb-3">Gestión de Imágenes</h4>

                <div class="col-md-12 pb-3 border-bottom">
                    <label class="form-label fw-bold">Portada Actual</label>
                    <div id="portada-existente-container">
                        @{
                            var portada = Model.listImagenes?.FirstOrDefault(i => i.Tipo == 1);
                        }
                        @if (portada != null)
                        {
                            <div class="position-relative d-inline-block" id="container-img-@portada.IdImagen">
                                <img src="@portada.Url" alt="Portada actual" class="img-thumbnail" style="max-height: 200px;">
                                <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1"
                                        onclick="marcarParaEliminar(@portada.IdImagen, 'container-img-@portada.IdImagen')">&times; Eliminar</button>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No hay imagen de portada.</p>
                        }
                    </div>
                    <label for="FilePortada" class="form-label mt-2">Reemplazar o agregar portada:</label>
                    <input type="file" asp-for="FilePortada" class="form-control" accept="image/*" id="input-portada-modificar" />
                    <div id="preview-portada-modificar" class="mt-2"></div>
                </div>

                <div class="col-md-12 pt-3">
                    <label class="form-label fw-bold">Galería Actual</label>
                    <div class="d-flex flex-wrap gap-2">
                        @{
                            var galeria = Model.listImagenes?.Where(i => i.Tipo == 2).ToList() ?? new List<Imagen>();
                        }
                        @if (galeria.Any())
                        {
                            foreach (var imagen in galeria)
                            {
                                <div class="position-relative" id="container-img-@imagen.IdImagen">
                                    <img src="@imagen.Url" class="img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;">
                                    <button type="button" class="btn btn-danger btn-xs position-absolute top-0 end-0 m-1" style="--bs-btn-padding-y: .1rem; --bs-btn-padding-x: .4rem; --bs-btn-font-size: .75rem;"
                                            onclick="marcarParaEliminar(@imagen.IdImagen, 'container-img-@imagen.IdImagen')">&times;</button>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No hay imágenes en la galería.</p>
                        }
                    </div>

                    <label for="FileGaleria" class="form-label mt-3">Agregar nuevas imágenes a la galería:</label>
                    <input type="file" asp-for="FileGaleria" class="form-control" multiple accept="image/*" id="input-galeria-modificar" />
                    <div id="preview-galeria-modificar" class="mt-2 d-flex flex-wrap gap-2"></div>
                </div>

                <div id="container-eliminar-ids"></div>
            </div>
            @* --- FIN DE LA SECCIÓN DE IMÁGENES --- *@

            <br>
            <div class="d-flex justify-content-end align-items-center mt-4">
                <a asp-action="Listar" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-success">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <script src="~/js/inmueble-form.js"></script>
    <script src="~/js/manejo-imagenes-modificar.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Inicializamos el mapa y Select2
            inicializarFormularioInmueble({
                idPropietario: @Model.IdPropietario,
                propietarioNombre: '@(Model.Propietario?.Nombre + " " + Model.Propietario?.Apellido + " (" + Model.Propietario?.Dni + ")")'
            });

            // Inicializamos las previews para los nuevos archivos a subir
            inicializarPreviewsModificar({
                idInputPortada: 'input-portada-modificar',
                idPreviewPortada: 'preview-portada-modificar',
                idInputGaleria: 'input-galeria-modificar',
                idPreviewGaleria: 'preview-galeria-modificar'
            });
        });
    </script>
}