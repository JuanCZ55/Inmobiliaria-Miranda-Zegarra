@model Inmobiliaria.Models.Inmueble
@{
  ViewData["Title"] = "Crear Inmueble";
  ViewData["SubTitle"] = "Inmuebles";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="px-3 py-1 row justify-content-center h-100">
  <div class="col-md-8 p-3">

    <form asp-action="Crear" method="post"
      class="row shadow-lg rounded border bg-light p-4 h-100 justify-content-evenly">

      <div class="col-md-12 d-flex justify-content-center align-items-center">
        <h2 class="text-center">Crear Inmueble</h2>
      </div>

      <div class="row">
        <div class="col-md-12 pb-2">
          <label for="select-propietario" class="form-label">Propietario</label>
          <select asp-for="IdPropietario" class=" " id="select-propietario" style="width: 100%">
            <option value="">Busque un propietario...</option>
          </select>
          <span asp-validation-for="IdPropietario" class="text-danger"></span>
        </div>

        <div class="col-md-12 pb-2">
          <label asp-for="Direccion" class="form-label"></label>
          <input asp-for="Direccion" class="form-control" />
          <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>

        <div class="col-md-6 pb-2">
          <label asp-for="IdTipoInmueble" class="form-label">Tipo de Inmueble</label>
          <select asp-for="IdTipoInmueble" class="form-select"
            asp-items="@(ViewBag.Tipos != null ? new SelectList(ViewBag.Tipos, "IdTipoInmueble", "Nombre") : new SelectList(new List<string>()))">
            <option value="">Seleccione un tipo...</option>
          </select>
          <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
        </div>

        @if (ViewBag.Error != null)
        {
          <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="col-md-6 pb-2">
          <label asp-for="Uso" class="form-label"></label>
          <select asp-for="Uso" class="form-select">
            <option value="">Seleccione un uso...</option>
            <option value="1">Residencial</option>
            <option value="2">Comercial</option>
          </select>
          <span asp-validation-for="Uso" class="text-danger"></span>
        </div>

        <div class="col-md-6 pb-2">
          <label asp-for="CantidadAmbientes" class="form-label"></label>
          <select asp-for="CantidadAmbientes" class="form-select"
            asp-items="@(new SelectList(Enumerable.Range(1, 20)))">
            <option value="">Seleccione una cantidad...</option>
          </select>
          <span asp-validation-for="CantidadAmbientes" class="text-danger"></span>
        </div>

        <div class="col-md-6 pb-2">
          <label asp-for="Longitud" class="form-label"></label>
          <input asp-for="Longitud" class="form-control" />
          <span asp-validation-for="Longitud" class="text-danger"></span>
        </div>

        <div class="col-md-6 pb-2">
          <label asp-for="Latitud" class="form-label"></label>
          <input asp-for="Latitud" class="form-control" />
          <span asp-validation-for="Latitud" class="text-danger"></span>
        </div>

        <div class="col-md-6 pb-2">
          <label asp-for="Precio" class="form-label"></label>
          <input asp-for="Precio" class="form-control" />
          <span asp-validation-for="Precio" class="text-danger"></span>
        </div>

        <div class="col-md-12 pb-2">
          <label asp-for="Descripcion" class="form-label"></label>
          <input asp-for="Descripcion" class="form-control" />
          <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
      </div>

      <div class="aling-items-center justify-content-center d-flex">
        <div class="d-flex justify-content-end align-items-center">
          <button type="submit" class="btn btn-success">Crear Inmueble</button>
        </div>
      </div>

    </form>

  </div>
</div>

@section Scripts {
  @await Html.PartialAsync("_ValidationScriptsPartial")
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <style>
    .select2-container--bootstrap-5 .select2-selection--single {
      display: flex;
      align-items: flex-start !important;
      min-height: 38px;
      padding-top: 0.25rem;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
      display: block;
      line-height: 1.2;
      padding-top: 0 !important;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script>
    $(document).ready(function () {
      $('#select-propietario').select2({
        theme: 'bootstrap-5',
        placeholder: 'Busque un propietario...',
        allowClear: false,
        ajax: {
          url: 'http://localhost:5227/Propietario/ListarPropietarios',
          dataType: 'json',
          delay: 250,
          data: function (params) {
            var nombre = params.term || '';
            var dni = '';
            if (/^\d+$/.test(nombre)) {
              dni = nombre;
              nombre = '';
            }
            return { nombre: nombre, dni: dni };
          },
          processResults: function (data) {
            return {
              results: $.map(data, function (item) {
                return {
                  id: item.idPropietario,
                  text: item.nombre + ' ' + item.apellido + ' (' + item.dni + ')',
                  nombre: item.nombre,
                  apellido: item.apellido,
                  dni: item.dni
                };
              })
            };
          }
        },
        minimumInputLength: 3,
        templateSelection: function (data) {
          if (!data.id) return data.text;
          // Si los datos vienen del select inicial (sin AJAX), usar text
          if (!data.nombre || !data.apellido || !data.dni) return data.text;
          return data.nombre + ' ' + data.apellido + ' (' + data.dni + ')';
        },
        templateResult: function (data) {
          if (!data.id) return data.text;
          return $('<div><b>' + data.nombre + ' ' + data.apellido + '</b><br><small>DNI: ' + data.dni + '</small></div>');
        },
        escapeMarkup: function (m) { return m; },
        language: {
          inputTooShort: () => 'Ingrese al menos 3 caracteres',
          noResults: () => 'No se encontraron resultados',
          searching: () => 'Buscando...'
        }
      });
    });
  </script>

}