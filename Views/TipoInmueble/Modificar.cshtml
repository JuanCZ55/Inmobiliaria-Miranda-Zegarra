@model Inmobiliaria.Models.TipoInmueble
@{
  ViewData["Title"] = "Modificar Tipo de Inmueble";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="px-3 py-1 row justify-content-center ">
  <div class="col-md-8 p-3">
    <form asp-action="Modificar" method="post" class="row shadow-lg rounded border bg-light p-4">
      <div class="col-12">
        <h2 class="text-center">Modificar Tipo de Inmueble</h2>
      </div>
      <input type="hidden" asp-for="IdTipoInmueble" />
      <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
      </div>
      <div class="d-flex justify-content-between mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
        <button type="submit" class="btn btn-success">Guardar Cambios</button>
      </div>
    </form>
  </div>
</div>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}