@model IEnumerable<Inmobiliaria.Models.TipoInmueble>
@{
  ViewData["Title"] = "Listado de Tipos de Inmueble";
  Layout = "~/Views/Shared/_Layout.cshtml";
  var paginaActual = ViewBag.PaginaActual ?? 1;
  var totalPaginas = ViewBag.TotalPaginas ?? 1;
  var nombreFiltro = ViewBag.Nombre ?? "";
}

<div class="d-flex align-items-center">
  <h2 class="text-center py-4">@ViewData["Title"]</h2>

  <a class="btn btn-primary ms-3" asp-action="Crear">
    <img class="invert-color-icon" src="~/images/icon/Agregar.png" alt="">
  </a>
</div>

<div class="d-flex flex-column">
  <form method="get" asp-action="Listar" class="row g-2 bg-white shadow-sm rounded p-3">
    <div class="row">
      <div class="col-md-12 d-flex justify-content-start align-items-center pb-2">
        <h4 class="ps-2 pe-3 m-0 fw-bold">Filtrar</h4>
      </div>
      <div class="col-md-2">
        <div class="zeg-field" style="max-width: 300px;">
          <input type="text" id="nombre" name="nombre" value="@nombreFiltro" class="zeg-input"/>
          <label for="nombre">Filtrar por Nombre</label>
        </div>
      </div>
      <div class="col-md-2 d-flex justify-content-start align-items-center pb-3">
        <button type="submit" class="btn btn-outline-primary fw-bold me-4">Filtrar</button>
      </div>
    </div>
  </form>
</div>


<div class="table-responsive shadow-sm rounded mt-4">
  <table class="table table-hover table-striped align-middle mb-0">
    <thead class="bg-primary text-white text-center">
      <tr>
        <th>@Html.DisplayNameFor(model => model.First().IdTipoInmueble)</th>
        <th>@Html.DisplayNameFor(model => model.First().Nombre)</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody class="text-center">
      @if (Model != null && Model.Any())
      {
        @foreach (var tipo in Model)
        {
          <tr>
            <td>@tipo.IdTipoInmueble</td>
            <td>@tipo.Nombre</td>
            <td class="d-flex justify-content-center">
              <a asp-action="Modificar" asp-route-id="@tipo.IdTipoInmueble" class="btn btn-link" data-bs-toggle="tooltip"
                title="Modificar Tipo de Inmueble">
                <img src="~/images/icon/Editar.png" alt="Editar">
              </a>
              <form asp-action="Eliminar" asp-route-id="@tipo.IdTipoInmueble" method="post">
                <button type="submit" class="btn btn-link" data-bs-toggle="tooltip" title="Eliminar Tipo de Inmueble">
                  <img src="~/images/icon/Eliminar.png" alt="Eliminar" />
                </button>
              </form>
            </td>
          </tr>
        }
      }
    </tbody>
  </table>
</div>


@if (totalPaginas > 1)
{
  <nav aria-label="Paginación" class="mt-3">
    <ul class="pagination justify-content-center">

      @* Botón al inicio "<" *@
      <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
        <a class="page-link" asp-action="Listar" asp-route-dni="@nombreFiltro" asp-route-PaginaActual="1">&lt;</a>
      </li>

      @{
        int botonesCentrales = 8; // cantidad de botones centrales
        int mitad = botonesCentrales / 2;

        int inicio = Math.Max(paginaActual - mitad + 1, 1);
        int fin = inicio + botonesCentrales - 1;

        if (fin > totalPaginas - 2)
        {
          fin = totalPaginas - 2; // reservamos espacio para los dos últimos
          inicio = Math.Max(fin - botonesCentrales + 1, 1);
        }

        // Botones centrales
        for (int i = inicio; i <= fin; i++)
        {
          <li class="page-item @(i == paginaActual ? "active" : "")">
            <a class="page-link" asp-action="Listar" asp-route-dni="@nombreFiltro" asp-route-PaginaActual="@i">@i</a>
          </li>
        }

        @* Botón "..." *@
        @if (fin < totalPaginas - 2)
        {
          <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @* Dos últimos botones *@
        for (int i = Math.Max(totalPaginas - 1, fin + 1); i <= totalPaginas; i++)
        {
          <li class="page-item @(i == paginaActual ? "active" : "")">
            <a class="page-link" asp-action="Listar" asp-route-dni="@nombreFiltro" asp-route-PaginaActual="@i">@i</a>
          </li>
        }
      }

      @* Botón final ">" *@
      <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
        <a class="page-link" asp-action="Listar" asp-route-dni="@nombreFiltro" asp-route-PaginaActual="@totalPaginas">&gt;</a>
      </li>

    </ul>
  </nav>
}