@model Inmobiliaria.Models.Pago
@{
  ViewData["Title"] = "Crear Contrato";
  ViewData["SubTitle"] = "Pagos";
  Layout = "~/Views/Shared/_Layout.cshtml";
  var actionForm = Model.IdPago == 0 ? "Crear" : Model.Estado == 1 ? "CancelarPago" : Model.Estado == 2 ? "ActivarPago" :
  null;
}
<div class="row h-100">
  <!-- COLUMNA IZQUIERDA -->
  <div class="col-md-6 py-5 d-flex justify-content-center">
    <div class="col-md-10 shadow-lg rounded border bg-light p-5 h-100 m-0">
      <form asp-action="@actionForm" id="formPago" method="post"
        class="h-100 d-flex flex-column justify-content-between">
        <div class="h-100 d-flex flex-column">
          <h2 class="text-center m-0 pb-5">Pago</h2>
          <div class="row g-3 border rounded p-3">
            @if (Model.IdPago > 0)
            {
              <div class="col-md-12">
                <label asp-for="numeroPago" class="form-label">Número de pago</label>
                <input asp-for="numeroPago" type="number" class="form-control" readonly />
              </div>
            }
            else
            {
              <div class="col-md-12">
                <label asp-for="IdContrato" class="form-label">Cod. Contrato</label>
                <input asp-for="IdContrato" oninput="buscarContrato()" type="number" class="form-control" />
              </div>
            }

            <div class="col-md-12">
              <label asp-for="Concepto" class="form-label">Concepto</label>
              @if (Model.IdPago > 0)
              {
                <input asp-for="Concepto" type="text" class="form-control" readonly />
              }
              else
              {
                <select asp-for="Concepto" class="form-select">
                  <option value="">-- Seleccione un concepto --</option>
                  <option value="Alquiler mensual">Alquiler (mensual)</option>
                  <option value="Alquiler adelantado">Alquiler (adelantado)</option>
                  <option value="Alquiler proporcional">Alquiler (proporcional)</option>
                  <option value="Expensas ordinarias">Expensas (ordinarias)</option>
                  <option value="Expensas extraordinarias">Expensas (extraordinarias)</option>
                </select>
              }
            </div>
            <div class="col-md-12">
              <label asp-for="FechaPago" class="form-label">Fecha de Pago</label>
              <input asp-for="FechaPago" type="date" class="form-control" readonly />
            </div>
            <div class="col-md-12">
              <label asp-for="Monto" class="form-label">Monto a pagar</label>
              <input asp-for="Monto" type="number" class="form-control" />
            </div>
            @if (Model.IdPago > 0)
            {
              <div class="col-md-12">
                <label class="form-label">Estado</label>
                <input class="form-control" type="text" readonly
                  value="@(Model.Estado == 1 ? "Activo" : Model.Estado == 2 ? "Cancelado" : "")" />
              </div>
              <input asp-for="IdPago" type="hidden" id="IdContrato" />
            }
          </div>
        </div>
        <div class="d-flex justify-content-between pt-4 mt-4 gap-2">
          @if (Model.IdPago <= 0)
          {
            <button type="submit" class="btn btn-success">Crear</button>

          }
          else
          {
            @if (Model.Estado == 1)
            {
              <form asp-action="CancelarPago" method="post">
                <input name="idPago" value="@Model.IdPago" type="hidden" id="IdContrato" />
                <button type="submit" class="btn btn-outline-danger" @(Model.contrato?.Estado == "Finalizado" || Model.contrato?.Estado == "Cancelado con Multa Saldada" ? "disabled" : "")>
                  Cancelar Pago
                </button>

              </form>
            }
            else if (Model.Estado == 2)
            {
              <form asp-action="ActivarPago" method="post">
                <input name="idPago" value="@Model.IdPago" type="hidden" id="IdContrato" />
                <button type="submit" class="btn btn-outline-success" @(Model.contrato?.Estado == "Finalizado" || Model.contrato?.Estado == "Cancelado con Multa Saldada" ? "disabled" : "")>
                  Activar Pago
                </button>
              </form>
            }
          }
          <a href="/Pago/Listar" class="btn btn-secondary">Volver</a>
        </div>
      </form>
    </div>
  </div>

  <!-- COLUMNA Derecha -->
  <div class="col-md-6 py-5 row justify-content-between">
    <div class="col-md-10 shadow-lg rounded border bg-light p-5 h-100">
      <div>
        <h2 class="text-center">Contrato - @Model.IdContrato</h2>
        <div class="row">
          <div class="col-md-12 py-3">
            <div class="row border rounded p-3">
              <div class="col-md-4 mb-3">
                <label for="Inquilino_Dni" class="form-label">DNI Inquilino</label>
                <input id="Inquilino_Dni" type="text" class="form-control" value="@Model.contrato?.Inquilino?.Dni"
                  readonly />
              </div>
              <div class="col-md-8 mb-3">
                <label for="Inquilino_Nombre" class="form-label">Nombre y Apellido</label>
                @{
                  var NombreCompleto = Model.contrato?.Inquilino?.Nombre + " " + Model.contrato?.Inquilino?.Apellido;
                }
                <input id="Inquilino_Nombre" type="text" class="form-control" value="@NombreCompleto" readonly />
              </div>
              <div class="col-md-6">
                <label for="Inquilino_Telefono" class="form-label">Teléfono</label>
                <input id="Inquilino_Telefono" type="text" class="form-control"
                  value="@Model.contrato?.Inquilino?.Telefono" readonly />
              </div>
              <div class="col-md-6">
                <label for="Inquilino_Email" class="form-label">Email</label>
                <input id="Inquilino_Email" type="email" class="form-control" value="@Model.contrato?.Inquilino?.Email"
                  readonly />
              </div>
            </div>
          </div>
          <div class="col-md-12 py-3">
            <div class="row border rounded p-3">
              <div class="col-md-6 mb-3">
                <label for="Inmueble_Id" class="form-label">Cod. Inmueble</label>
                <input id="Inmueble_Id" type="text" class="form-control" value="@Model.contrato?.Inmueble?.IdInmueble"
                  readonly />
              </div>
              <div class="col-md-6 mb-3">
                <label for="Inmueble_Tipo" class="form-label">Tipo de Inmueble</label>
                <input id="Inmueble_Tipo" type="text" class="form-control"
                  value="@Model.contrato?.Inmueble?.TipoInmueble?.Nombre" readonly />
              </div>
              <div class="col-md-12">
                <label for="Inmueble_Direccion" class="form-label">Dirección</label>
                <input id="Inmueble_Direccion" type="text" class="form-control"
                  value="@Model.contrato?.Inmueble?.Direccion" readonly />
              </div>
            </div>
          </div>
          <div class="col-md-12">
            <div class="row border rounded p-3">
              <div class="col-md-6">
                <label class="form-label">Fecha Desde</label>
                <input id="Contrato_FechaDesde" type="date" class="form-control"
                  value="@(Model.contrato?.FechaInicio.ToString("yyyy-MM-dd"))" readonly />
              </div>
              <div class="col-md-6">
                <label class="form-label">Fecha Hasta</label>
                <input id="Contrato_FechaHasta" type="date" class="form-control"
                  value="@(Model.contrato?.FechaFinalizacion.ToString("yyyy-MM-dd"))" readonly />
              </div>
              <div class="col-md-6">
                <label class="form-label">Monto</label>
                <input id="Contrato_Monto" type="text" class="form-control" value="@Model.contrato?.Monto" readonly />
              </div>
              <div
                class="@(Model.contrato?.Estado == "Cancelado con Multa Saldada" || Model.contrato?.Estado == "Cancelado con Multa Pendiente" ? "col-md-6" : "col-md-6 d-none")">

                <label class="form-label">Fecha de Cancelación</label>
                <input id="Contrato_FechaFin" type="date" class="form-control"
                  value="@(Model.contrato?.FechaCancelacion?.ToString("yyyy-MM-dd"))" readonly />
              </div>
              <div
                class="@(Model.contrato?.Estado == "Cancelado con Multa Saldada" || Model.contrato?.Estado == "Cancelado con Multa Pendiente" ? "col-md-6" : "col-md-6 d-none")">

                <label class="form-label">Multa</label>
                <input id="Contrato_Multa" type="text" class="form-control" value="@Model.contrato?.Multa" readonly />
              </div>
              <div class="col-md-6">
                <label class="form-label">Estado</label>
                <input id="Contrato_Estado" type="text" class="form-control" value="@Model.contrato?.Estado" readonly />
              </div>
            </div>
          </div>

          <input type="hidden" id="Contrato_Inquilino" />
          <input type="hidden" id="Contrato_Inmueble" />
          <input type="hidden" id="Inmueble_Precio" />
          <input type="hidden" id="Inmueble_Descripcion" />
        </div>
      </div>
    </div>
  </div>
</div>



@section Scripts {
  @if (Model.IdPago <= 0)
  {
    <script>
      async function buscarContrato() {
        const idContratoInput = document.getElementById("IdContrato");
        const idContrato = idContratoInput.value.trim();

        document.getElementById("Contrato_Inquilino").value = "";
        document.getElementById("Contrato_Inmueble").value = "";
        document.getElementById("Contrato_FechaDesde").value = "";
        document.getElementById("Contrato_FechaHasta").value = "";
        document.getElementById("Contrato_Monto").value = "";
        document.getElementById("Contrato_Estado").value = "";

        const fechaFinDiv = document.getElementById("Contrato_FechaFin")?.closest(".col-md-6");
        if (fechaFinDiv) {
          fechaFinDiv.classList.add("d-none");
          document.getElementById("Contrato_FechaFin").value = "";
        }

        const multaDiv = document.getElementById("Contrato_Multa")?.closest(".col-md-6");
        if (multaDiv) {
          multaDiv.classList.add("d-none");
          document.getElementById("Contrato_Multa").value = "";
        }

        document.getElementById("Inquilino_Dni").value = "";
        document.getElementById("Inquilino_Nombre").value = "";
        document.getElementById("Inquilino_Telefono").value = "";
        document.getElementById("Inquilino_Email").value = "";

        document.getElementById("Inmueble_Id").value = "";
        document.getElementById("Inmueble_Tipo").value = "";
        document.getElementById("Inmueble_Precio").value = "";
        document.getElementById("Inmueble_Direccion").value = "";
        document.getElementById("Inmueble_Descripcion").value = "";

        try {
          if (!/^[0-9]+$/.test(idContrato) || parseInt(idContrato) < 1) return;

          const response = await fetch(`/Contrato/Contrato?idContrato=${idContrato}`);
          if (!response.ok) return;

          const data = await response.json();
          if (!data || data.idContrato == 0) return;

          // Función para formatear fechas tipo ISO
          const formatearFecha = fecha => fecha ? fecha.split("T")[0] : "";

          document.getElementById("Contrato_Inquilino").value = data.idInquilino || "";
          document.getElementById("Contrato_Inmueble").value = data.idInmueble || "";
          document.getElementById("Contrato_FechaDesde").value = formatearFecha(data.fechaInicio);
          document.getElementById("Contrato_FechaHasta").value = formatearFecha(data.fechaFinalizacion);
          document.getElementById("Contrato_Monto").value = data.monto || "";
          document.getElementById("Contrato_Estado").value = data.estado || "";

          if (data.fechaCancelacion) {
            fechaFinDiv.classList.remove("d-none");
            document.getElementById("Contrato_FechaFin").value = formatearFecha(data.fechaCancelacion);
          }

          if (data.multa && parseFloat(data.multa) > 0) {
            multaDiv.classList.remove("d-none");
            document.getElementById("Contrato_Multa").value = data.multa;
          }

          document.getElementById("Inquilino_Dni").value = data.inquilino?.dni || "";
          document.getElementById("Inquilino_Nombre").value = (data.inquilino?.nombre || "") + " " + (data.inquilino?.apellido || "");
          document.getElementById("Inquilino_Telefono").value = data.inquilino?.telefono || "";
          document.getElementById("Inquilino_Email").value = data.inquilino?.email || "";

          document.getElementById("Inmueble_Id").value = data.inmueble?.idInmueble || "";
          document.getElementById("Inmueble_Tipo").value = data.inmueble?.tipoInmueble?.nombre || "";
          document.getElementById("Inmueble_Precio").value = data.inmueble?.precio || "";
          document.getElementById("Inmueble_Direccion").value = data.inmueble?.direccion || "";
          document.getElementById("Inmueble_Descripcion").value = data.inmueble?.descripcion || "";

          idContratoInput.value = data.idContrato;

          const btnCrear = document.querySelector("button.btn-success");
          if (btnCrear) {
            btnCrear.disabled = data.estado === "Finalizado" || data.estado === "Cancelado con Multa Saldada";
          }

        } catch (error) {
          console.error("Hubo un problema al buscar contrato:", error);
        }
      }
    </script>
  }
}